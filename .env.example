# Neon (base de données Postgres)
# Project Settings → Connection Details → Connection string ("Pooled connection")
DATABASE_URL=

# Auth.js — clé de signature des sessions. Génère une valeur aléatoire avec :
#   openssl rand -base64 32
AUTH_SECRET=

# Cloudflare R2 (stockage vidéo)
# Dashboard R2 → Manage R2 API Tokens → créer un token avec accès Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=videos
